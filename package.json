{
  "name": "universal-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file=.env.local --import tsx src/db/seed.ts",
    "db:link-owner": "node --env-file=.env.local --import tsx src/db/link-dev-owner.ts",
    "test": "node --import tsx --test src/lib/auth/email-identity.test.ts src/lib/auth/safe-next-path.test.ts src/lib/validation/deal.test.ts src/modules/deals/transition-deal.test.ts src/modules/invitations/invitation-token.test.ts src/modules/members/owner-assignment-policy.test.ts src/modules/tasks/recurrence.test.ts src/modules/activity/task-activity.test.ts",
    "test:integration": "node --env-file=.env.local --import tsx --test src/modules/members/owner-guard.integration.test.ts src/modules/invitations/accept-invitation.integration.test.ts src/modules/invitations/create-invitation.integration.test.ts src/modules/access/tenant-access.integration.test.ts src/modules/clients/client-company-relation.integration.test.ts src/modules/security/tenant-boundaries.integration.test.ts src/modules/members/owner-assignment.integration.test.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.6",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
